/*****----- Configuration -----*****/

configuration {
    modi:                       "drun,filebrowser";
    show-icons:                 true;
    display-drun:               " Applications";
    drun-display-format:        "{name}";
}


/*****----- Global Properties -----*****/

@import                         "../colors.rasi"
@import                         "../fonts/font.rasi"


/*****----- Main Window -----*****/

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       900px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                var(border);
    background-color:            var(bg-main);
    cursor:                      "default";
}


/*****----- Main Box -----*****/

mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                var(border);
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
    orientation:                 horizontal;
}


/*****----- Inputbar -----*****/

inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
    children:                    [ "prompt", "entry" ];
    orientation:                 vertical;
}

prompt {
    enabled:                     true;
    expand:                      false;
    padding:                     15px 50px;
    border-radius:               10px;
    background-color:            var(selected-bg);
    text-color:                  var(selected-fg);
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "::";
    background-color:            inherit;
    text-color:                  inherit;
}

entry {
    enabled:                     true;
    expand:                      false;
    padding:                     15px 20px;
    border-radius:               10px;
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}


/*****----- Listview -----*****/

listview {
    enabled:                     true;
    columns:                     3;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            transparent;
    text-color:                  var(fg-primary);
    cursor:                      "default";
}

scrollbar {
    handle-width:                5px;
    handle-color:                var(accent);
    border-radius:               0px;
    background-color:            var(bg-surface);
}


/*****----- Elements -----*****/

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     8px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                var(border);
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
    orientation:                 horizontal;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
}

element alternate.normal {
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
}

element selected.normal {
    border:                      0px 2px 0px 2px;
    border-radius:               10px;
    border-color:                var(selected-bg);
    background-color:            var(selected-bg);
    text-color:                  var(selected-fg);
}

element-icon {
    padding:                     0px;
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Message -----*****/

error-message {
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
}

textbox {
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}