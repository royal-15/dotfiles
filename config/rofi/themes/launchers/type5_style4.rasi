/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,filebrowser,run,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:              "{w}   {c}   {t}";
}


/*****----- Global Properties -----*****/
@import                         "../colors.rasi"
@import                         "../fonts/font.rasi"


/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       800px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border-radius:               20px;
    cursor:                      "default";
    background-color:            var(bg-main);
}


/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     30px;
    padding:                     30px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview", "mode-switcher" ];
}


/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px 200px;
    padding:                     5px;
    border:                      1px;
    border-radius:               100%;
    border-color:                var(border);
    background-color:            transparent;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    padding:                     8px 11px;
    border-radius:               100%;
    background-color:            var(fg-primary);
    text-color:                  var(selected-fg);
    str:                         "";
}

entry {
    enabled:                     true;
    padding:                     8px 12px;
    border:                      0px;
    background-color:            transparent;
    text-color:                  var(fg-primary);
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     2;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    background-color:            transparent;
    cursor:                      "default";
}


/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     5px;
    border:                      0px;
    border-radius:               100%;
    border-color:                var(border);
    background-color:            transparent;
    text-color:                  var(fg-muted);
    cursor:                      pointer;
}

element normal.active {
    background-color:            var(bg-elevated);
    text-color:                  var(accent);
}

element selected.normal {
    background-color:            var(bg-elevated);
    text-color:                  var(selected-bg);
}

element selected.active {
    background-color:            var(bg-elevated);
    text-color:                  var(danger);
}

element-icon {
    background-color:            transparent;
    size:                        24px;
    cursor:                      inherit;
}

element-text {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                     true;
    expand:                      false;
    spacing:                     0px;
    margin:                      0px 200px;
    padding:                     12px;
    border-radius:               100%;
    background-color:            var(bg-elevated);
}

button {
    background-color:            inherit;
    text-color:                  var(fg-primary);
    cursor:                      pointer;
}

button selected {
    background-color:            inherit;
    text-color:                  var(selected-bg);
}


/*****----- Message -----*****/
error-message {
    padding:                     20px;
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
}

message {
    padding:                     0px;
    background-color:            inherit;
    text-color:                  var(selected-bg);
}

textbox {
    padding:                     0px;
    border-radius:               0px;
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}