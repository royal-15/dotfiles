/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,filebrowser";
    show-icons:                 true;
    display-drun:               " Applications";
    drun-display-format:        "{name}";
}


/*****----- Global Properties -----*****/
@import                         "../colors.rasi"
@import                         "../fonts/font.rasi"


/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    south;
    anchor:                      south;
    fullscreen:                  false;
    width:                       435px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               11px 11px 0px 0px;
    border-color:                var(border);
    background-color:            var(bg-main);
    cursor:                      "default";
}


/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                var(border);
    background-color:            transparent;
    children:                    [ "listview", "entry" ];
}


/*****----- Inputbar -----*****/
entry {
    enabled:                     true;
    expand:                      false;
    padding:                     20px 0px;
    background-color:            var(selected-bg);
    text-color:                  var(selected-fg);
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}


/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     3;
    lines:                       3;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            transparent;
    text-color:                  var(fg-primary);
    cursor:                      "default";
}

scrollbar {
    handle-width:                5px;
    handle-color:                var(selected-bg);
    border-radius:               0px;
    background-color:            var(bg-surface);
}


/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     20px 10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            transparent;
    text-color:                  var(fg-primary);
    orientation:                 vertical;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
}

element selected.normal {
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        55px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}


/*****----- Message -----*****/
error-message {
    padding:                     15px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
}

textbox {
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}