/*****----- Configuration -----*****/

configuration {
    modi:                       "drun,filebrowser,window";
    show-icons:                 true;
    display-drun:               "APPS";
    display-run:                "RUN";
    display-filebrowser:        "FILES";
    display-window:             "WINDOW";
    drun-display-format:        "{name}\n[<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:              "Class : {c}\nWorkspace : {w}";
}


/*****----- Global Properties -----*****/

@import                         "../colors.rasi"
@import                         "../fonts/font.rasi"


/*****----- Main Window -----*****/

window {
    /* properties for window widget */

    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  true;
    // width:                       800px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border-radius:               11px;
    cursor:                      "default";
    background-color:            transparent;
    // background-image:            url("~/.config/theme-switcher/state/current_wallpaper", width);
}


/*****----- Main Box -----*****/

mainbox {
    enabled:                     true;
    spacing:                     20px;
    margin:                      40px;
    padding:                     40px;
    border-radius:               12px;
    background-color:            var(bg-surface);
    children:                    [ "inputbar", "mode-switcher", "listview" ];
}


/*****----- Inputbar -----*****/

inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px 10%;
    padding:                     0px 0px 10px 0px;
    border:                      0px 0px 2px 0px;
    border-radius:               0px;
    border-color:                var(border);
    background-color:            transparent;
    children:                    [ "entry" ];
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  var(fg-primary);
    cursor:                      text;
    placeholder:                 "Type to filter";
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}


/*****----- Listview -----*****/

listview {
    enabled:                     true;
    columns:                     3;
    lines:                       3;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     40px;
    margin:                      0px;
    padding:                     20px 0px 0px 0px;
    border:                      0px solid;
    background-color:            transparent;
    cursor:                      "default";
}


/*****----- Elements -----*****/

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     20px;
    border:                      1px solid;
    border-radius:               8px;
    border-color:                var(border);
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
    cursor:                      pointer;
}

element normal.active {
    background-color:            var(accent);
    text-color:                  var(selected-fg);
}

element selected.normal {
    background-color:            var(selected-bg);
    text-color:                  var(selected-fg);
}

element selected.active {
    background-color:            var(danger);
    text-color:                  var(selected-fg);
}

element-icon {
    background-color:            transparent;
    size:                        44px;
    cursor:                      inherit;
}

element-text {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Mode Switcher -----*****/

mode-switcher {
    enabled:                     true;
    expand:                      false;
    spacing:                     20px;
    margin:                      0px 10%;
    background-color:            transparent;
    text-color:                  var(fg-primary);
}

button {
    font:                        "Iosevka Nerd Font Bold 10";
    padding:                     9px;
    border:                      0px solid;
    border-radius:               100%;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      pointer;
}

button selected {
    background-color:            var(selected-bg);
    text-color:                  inherit;
}


/*****----- Message -----*****/

error-message {
    padding:                     20px;
    background-color:            transparent;
    text-color:                  var(fg-primary);
}

textbox {
    padding:                     20px;
    border-radius:               12px;
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
    vertical-align:              0.5;
    horizontal-align:            0.0;
}