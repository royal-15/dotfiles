/*****----- Configuration -----*****/

configuration {
    modi:                       "drun,filebrowser,window";
    show-icons:                 true;
    display-drun:               "Apps";
    display-run:                "Run";
    display-filebrowser:        "Files";
    display-window:             "Windows";
    drun-display-format:        "{name}\n[<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:              "Class : {c}\nWorkspace : {w}";
}


/*****----- Global Properties -----*****/

@import                         "../colors.rasi"
@import                         "../fonts/font.rasi"


/*****----- Main Window -----*****/

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       457px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border-radius:               11px;
    cursor:                      "default";
    background-color:            var(bg-main);
}


/*****----- Main Box -----*****/

mainbox {
    enabled:                     true;
    spacing:                     15px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "mode-switcher", "listview" ];
}


/*****----- Inputbar -----*****/

inputbar {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    background-color:            transparent;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    padding:                     12px 16px;
    border:                      0px;
    border-radius:               10px;
    border-color:                var(border);
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
    str:                         "";
}

entry {
    enabled:                     true;
    padding:                     12px 16px;
    border:                      0px;
    border-radius:               10px;
    border-color:                var(border);
    background-color:            var(bg-surface);
    text-color:                  var(fg-primary);
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Listview -----*****/

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    background-color:            transparent;
    cursor:                      "default";
}


/*****----- Elements -----*****/

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px solid;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  var(fg-primary);
    cursor:                      pointer;
}

element normal.active {
    background-color:            var(accent);
    text-color:                  var(selected-fg);
}

element selected.normal {
    border-radius:               10px;
    background-color:            var(selected-bg);
    text-color:                  var(selected-fg);
}

element selected.active {
    background-color:            var(danger);
    text-color:                  var(selected-fg);
}

element-icon {
    background-color:            transparent;
    size:                        47px;
    cursor:                      inherit;
}

element-text {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


/*****----- Mode Switcher -----*****/

mode-switcher {
    enabled:                     true;
    expand:                      false;
    spacing:                     15px;
    background-color:            transparent;
}

button {
    font:                        "Iosevka Nerd Font Bold 10";
    padding:                     7px;
    border-radius:               100%;
    background-color:            var(accent);
    text-color:                  var(selected-fg);
    cursor:                      pointer;
}

button selected {
    background-color:            var(selected-bg);
    text-color:                  var(selected-fg);
}


/*****----- Message -----*****/

error-message {
    padding:                     20px;
    background-color:            var(bg-main);
    text-color:                  var(fg-primary);
}

textbox {
    padding:                     0px;
    border-radius:               0px;
    text-color:                  var(fg-primary);
    vertical-align:              0.5;
    horizontal-align:            0.0;
}