/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                         "../colors.rasi"
@import                         "../fonts/font.rasi"

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      500px;
    // height:                     360px;

    margin:                     0px;
    padding:                    0px;

    border:                     1px solid;
    border-radius:              12px;
    border-color:               @border;

    background-color:           @bg-main;
    cursor:                     "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    16px;

    background-color:           transparent;

    children:                   [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;

    spacing:                    10px;
    padding:                    10px 12px;

    border:                     1px solid;
    border-radius:              10px;
    border-color:               @border;

    background-color:           @bg-elevated;
    text-color:                 @fg-primary;

    children:                   [ "entry" ];
}

entry {
    enabled:                    true;

    padding:                    3px 7px;

    background-color:           transparent;
    text-color:                 @fg-primary;

    placeholder:                "Type to search clipboard history...";
    placeholder-color:          @fg-muted;

    font:                       "monospace 11";
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;

    columns:                    1;
    lines:                      6;
    dynamic:                    true;
    fixed-height:               false;

    cycle:                      true;
    layout:                     vertical;

    spacing:                    6px;

    background-color:           transparent;
    cursor:                     "default";

    scrollbar:                  true;
}

/*****----- Scrollbar -----*****/
scrollbar {
    enabled:                    true;

    handle-width:               4px;
    handle-color:               @accent;

    border-radius:              8px;

    background-color:           @bg-surface;
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    children:                   [ "element-text" ];

    padding:                    10px 12px;

    border:                     0px;
    border-radius:              8px;

    background-color:           transparent;
    text-color:                 @fg-primary;

    cursor:                     pointer;
}

element-text {
    font:                       "monospace 11";

    background-color:           transparent;
    text-color:                 inherit;

    cursor:                     inherit;

    vertical-align:             0.5;
    horizontal-align:           0.0;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg-primary;
}

element normal.active,
element alternate.active {
    background-color:           @hover-bg;
    text-color:                 @hover-fg;
}

element normal.urgent,
element alternate.urgent {
    background-color:           @danger-soft;
    text-color:                 @danger;
}

element selected.normal {
    background-color:           @selected-bg;
    text-color:                 @selected-fg;
}

element selected.active {
    background-color:           @danger-soft;
    text-color:                 @danger;
}

element selected.urgent {
    background-color:           @hover-bg;
    text-color:                 @hover-fg;
}