{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "cssPriority": "user",
    "control-center-width": 405,
    "fit-to-screen": true,

    "notification-window-width": 400,
    "notification-icon-size": 44,
    "notification-body-image-height": 500,
    "notification-body-image-width": 500,
    "notification-inline-replies": true,
    "notification-2fa-action": false,

    "timeout": 3,
    "timeout-low": 2,
    "timeout-critical": 6,

    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": true,

    "widgets": [
        "mpris",
        "dnd",
        "volume",
        "backlight",
        "notifications",
        "buttons-grid"
    ],

    "widget-config": {
        "backlight": {
            "device": "intel_backlight",
            "label": "󰃠",
            "slider": true,
            "min": 10
        },
        "volume": {
            "device": "default",
            "label": "",
            "slider": true,
            "show-per-app": true
        },
        "dnd": {
            "text": "Do not disturb"
        },
        "mpris": {
            "image-size": 76,
            "image-radius": 14,
            "autohide": true,
            "blacklist": ["org.mpris.MediaPlayer2.playerctld"]
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.config/swaync/scripts/caffeine.sh --toggle'",
                    "update-command": "bash -c '$HOME/.config/swaync/scripts/caffeine.sh --is-running'"
                },
                {
                    "label": "",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.config/swaync/scripts/mictoggle.sh --toggle'",
                    "update-command": "bash -c '$HOME/.config/swaync/scripts/mictoggle.sh --is-muted'"
                }
            ]
        }
    }
}
