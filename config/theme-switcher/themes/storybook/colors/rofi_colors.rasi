/* Base */

* {
    bg-main:      #0f0e14;
    bg-surface:   #252d2c;
    bg-elevated:  #3f4136;

    fg-primary:   #c0cdbc;
    fg-secondary: #c0cdbc;
    fg-muted:     #868f83;

    accent:       #55B8BB;
    accent-soft:  rgba(85,184,187,0.12);

    danger:       #6C9079;
    danger-soft:  rgba(108,144,121,0.12);

    border:       #303233;
    shadow:       rgba(0,0,0,0.28);

    selected-bg:  #55B8BB;
    selected-fg:  #0f0e14;

    hover-bg:     rgba(85,184,187,0.06);
    hover-fg:     #c0cdbc;
}
