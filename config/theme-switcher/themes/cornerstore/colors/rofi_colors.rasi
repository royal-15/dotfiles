* {
    bg-main:      #0A0D0F;
    bg-surface:   #12191D;
    bg-elevated:  #192328;

    fg-primary:   #c4d9e1;
    fg-secondary: #89979d;
    fg-muted:     #89979d;

    accent:       #8bb9cc;
    accent-soft:  rgba(139,185,204,0.12);

    danger:       #4c7b87;
    danger-soft:  rgba(76,123,135,0.12);

    border:       #26353B;
    shadow:       rgba(0,0,0,0.30);

    selected-bg:  #7ab1c5;
    selected-fg:  #0A0D0F;

    hover-bg:     rgba(139,185,204,0.06);
    hover-fg:     #c4d9e1;
}