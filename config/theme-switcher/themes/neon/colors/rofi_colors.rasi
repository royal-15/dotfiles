* {
    bg-main:      #040505;
    bg-surface:   #101518;
    bg-elevated:  #172025;

    fg-primary:   #a3bcc0;
    fg-secondary: #8fa5a9;
    fg-muted:     #728386;

    accent:       #3ba4be;
    accent-soft:  rgba(59,164,190,0.12);

    danger:       #864db1;
    danger-soft:  rgba(134,77,177,0.12);

    border:       #222e34;
    shadow:       rgba(0,0,0,0.42);

    selected-bg:  #3ba4be;
    selected-fg:  #040505;

    hover-bg:     rgba(59,164,190,0.07);
    hover-fg:     #a3bcc0;
}