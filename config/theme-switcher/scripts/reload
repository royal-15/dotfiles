#!/usr/bin/env bash

set -euo pipefail

reload_hyprland() {
    command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true
}

reload_wallpaper() {
    local transition="${1:-wipe}"
    if command -v awww >/dev/null 2>&1; then
        awww img ~/.config/theme-switcher/state/current_wallpaper --transition-type "$transition" --transition-duration 1 >/dev/null 2>&1 || true
    fi
}

reload_kitty() {
    if command -v pgrep >/dev/null 2>&1; then
        local kitty_pids
        kitty_pids=$(pgrep -x kitty 2>/dev/null || true)
        if [[ -n "$kitty_pids" ]]; then
            echo "$kitty_pids" | xargs -r kill -SIGUSR1 2>/dev/null || true
        fi
    fi
}

reload_cava() {
    if command -v pgrep >/dev/null 2>&1; then
        local cava_pids
        cava_pids=$(pgrep -x cava 2>/dev/null || true)
        if [[ -n "$cava_pids" ]]; then
            echo "$cava_pids" | xargs -r kill -SIGUSR1 2>/dev/null || true
        fi
    fi
}

reload_gtk() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "$script_dir/reload_gtk.sh" ]]; then
        "$script_dir/reload_gtk.sh"
    fi
}

reload_qt() {
    # 1. In-place touch to notify QFileSystemWatcher monitors in qt5ct / qt6ct / Kvantum
    for conf in \
        "$HOME/.config/qt5ct/style-colors.conf" \
        "$HOME/.config/qt5ct/qt5ct.conf" \
        "$HOME/.config/qt6ct/style-colors.conf" \
        "$HOME/.config/qt6ct/qt6ct.conf" \
        "$HOME/.config/Kvantum/kvantum.kvconfig"; do
        if [[ -f "$conf" ]]; then
            touch "$conf"
        fi
    done

    # 2. Best-effort D-Bus notifications if session bus is active
    if command -v qdbus >/dev/null 2>&1; then
        qdbus org.kde.KGlobalSettings /KGlobalSettings org.kde.KGlobalSettings.notifyChange 0 0 2>/dev/null || true
    fi
    if command -v qdbus6 >/dev/null 2>&1; then
        qdbus6 org.kde.KGlobalSettings /KGlobalSettings org.kde.KGlobalSettings.notifyChange 0 0 2>/dev/null || true
    fi

    # 3. Reload xsettingsd if active (notifies Qt X11 / XWayland bridges)
    if command -v pgrep >/dev/null 2>&1 && pgrep -x xsettingsd >/dev/null 2>&1; then
        pkill -HUP -x xsettingsd 2>/dev/null || true
    fi

    echo "[reload_qt] Qt configuration touched and signals dispatched (active palettes updated; restart running apps for full SVG restyle)"
}

reload_all() {
    reload_hyprland
    reload_wallpaper fade
    reload_kitty
    reload_cava
    reload_gtk
    reload_qt
}

main() {
    [[ $# -gt 0 ]] || {
        echo "Usage: reload <aspect>..."
        exit 1
    }

    for aspect in "$@"; do
        case "$aspect" in
            hyprland)
                reload_hyprland
                ;;
            wallpaper)
                reload_wallpaper any
                ;;
            kitty)
                reload_kitty
                ;;
            cava)
                reload_cava
                ;;
            gtk)
                reload_gtk
                ;;
            qt)
                reload_qt
                ;;
            all)
                reload_all
                ;;
            *)
                echo "Unknown aspect: $aspect"
                exit 1
                ;;
        esac
    done
}

main "$@"
