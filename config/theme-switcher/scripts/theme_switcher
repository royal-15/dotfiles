#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Paths
###############################################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(realpath "$SCRIPT_DIR/..")"

STATE_FILE="$ROOT_DIR/state/active_theme.env"

source "$SCRIPT_DIR/state_utils.sh"

CURRENT_WALLPAPER_LINK="$ROOT_DIR/state/current_wallpaper"
BLURRED_WALLPAPER_LINK="$ROOT_DIR/state/blurred_wallpaper"
CURRENT_COLORS_JSON_LINK="$ROOT_DIR/state/current_colors.json"

BLUR_CACHE_DIR="$ROOT_DIR/cache/wallpaper-blur"

THEMES_DIR="$ROOT_DIR/themes"

###############################################################################
# Config Targets (preserved across packages)
###############################################################################

HYPR_THEME_DECORATIONS_TARGET="$HOME/.config/hypr/modules/theme_decorations.lua"

KITTY_TARGET="$HOME/.config/kitty/colors.conf"
CAVA_THEME_TARGET="$HOME/.config/cava/themes/current"
HYPRLOCK_COLORS_TARGET="$HOME/.config/hypr/hyprlock_colors.conf"

###############################################################################
# Helpers
###############################################################################

die() {
    echo "[ERROR] $*" >&2
    notify-send "Theme Switcher" "$*" || true
    exit 1
}

ok() {
    echo "[OK] $*"
    notify-send "Theme Switcher" "$*" || true
}

warn() {
    echo "[WARN] $*"
}

validate_component() {
    [[ "$1" =~ ^[A-Za-z0-9_.-]+$ && "$1" != . && "$1" != .. ]] || die "Invalid name: $1"
}

create_symlink() {
    local source="$1"
    local target="$2"

    mkdir -p "$(dirname "$target")"
    ln -sfn "$source" "$target"
}

generate_cava_theme() {
    local source="${1:-$CURRENT_COLORS_JSON_LINK}"
    local target="${2:-$CAVA_THEME_TARGET}"

    [[ -s "$source" ]] || die "Colors file not found or empty: $source"

    mkdir -p "$(dirname "$target")"
    python3 "$SCRIPT_DIR/generate_cava_theme.py" "$source" "$target"
}

generate_hyprlock_theme() {
    local source="${1:-$CURRENT_COLORS_JSON_LINK}"
    local target="${2:-$HYPRLOCK_COLORS_TARGET}"

    [[ -s "$source" ]] || die "Colors file not found or empty: $source"

    mkdir -p "$(dirname "$target")"
    jq -r '
    to_entries[] | "$" + .key + " = " + (
        if (.value | startswith("#")) then
            (if (.value | length) > 7 then "rgba(" + (.value | ltrimstr("#")) + ")" else "rgb(" + (.value | ltrimstr("#")) + ")" end)
        else
            .value
        end
    )
    ' "$source" > "$target"
}

###############################################################################
# Theme Switching
###############################################################################

switch_theme() {
    local theme="$1"
    validate_component "$theme"

    local colors_dir="$THEMES_DIR/$theme/colors"
    local hypr_dir="$THEMES_DIR/$theme/hypr"

    [[ -d "$colors_dir" ]] || die "Theme not found: $theme"
    local required
    for required in colors.json kitty_colors.conf; do
        [[ -s "$colors_dir/$required" ]] || die "Theme '$theme' is missing colors/$required"
    done
    [[ -s "$hypr_dir/theme_decorations.lua" ]] || die "Theme '$theme' is missing Hyprland theme decorations"
    local default_wallpaper
    default_wallpaper="$(find "$THEMES_DIR/$theme/wallpapers" -maxdepth 1 -type f ! -name '*_preview*' 2>/dev/null | sort | head -n1)"
    [[ -n "$default_wallpaper" ]] || die "Theme '$theme' has no wallpapers"

    create_symlink \
        "$hypr_dir/theme_decorations.lua" \
        "$HYPR_THEME_DECORATIONS_TARGET"

    create_symlink \
        "$colors_dir/colors.json" \
        "$CURRENT_COLORS_JSON_LINK"

    create_symlink \
        "$colors_dir/kitty_colors.conf" \
        "$KITTY_TARGET"

    generate_cava_theme \
        "$CURRENT_COLORS_JSON_LINK" \
        "$CAVA_THEME_TARGET"

    generate_hyprlock_theme \
        "$CURRENT_COLORS_JSON_LINK" \
        "$HYPRLOCK_COLORS_TARGET"

    local theme_file="$THEMES_DIR/$theme/theme.env"
    if [[ -f "$theme_file" ]]; then
        "$SCRIPT_DIR"/theme_helper "$theme_file"
    fi

    # Theme default wallpaper
    # Theme blurred wallpaper
    local blurred_wallpaper
    blurred_wallpaper="$(find "$BLUR_CACHE_DIR/$theme" \
        -maxdepth 1 \
        -type f 2>/dev/null \
        | sort \
        | sed -n '1p')" || true

    if [[ -z "$blurred_wallpaper" ]]; then
        warn "Theme '$theme' has no blurred wallpaper, falling back to original"
        blurred_wallpaper="$default_wallpaper"
    fi

    create_symlink \
        "$default_wallpaper" \
        "$CURRENT_WALLPAPER_LINK"

    create_symlink \
        "$blurred_wallpaper" \
        "$BLURRED_WALLPAPER_LINK"

    load_state
    ACTIVE_THEME="$theme"
    ACTIVE_WALLPAPER="$(basename "$default_wallpaper")"
    save_state

    # Quickshell in-memory theme update IPC
    qs -c ashell ipc call theme applyTheme "$theme" >/dev/null 2>&1 || quickshell -c ashell ipc call theme applyTheme "$theme" >/dev/null 2>&1 || true

    ok "Theme switched to '$theme'"
}

###############################################################################
# Wallpaper Switching
###############################################################################

find_wallpaper() {
    local wallpaper="$1"
    local theme="$2"
    validate_component "$theme"
    [[ "$wallpaper" != /* && "$wallpaper" != *..* && "$wallpaper" != *\\* ]] || return 1

    if [[ "$wallpaper" == *_preview* ]]; then
        local gif_name="${wallpaper%%_preview*}.gif"
        wallpaper="gifs/$gif_name"
    fi

    # 1. Exact path match
    local match
    match="$(find "$THEMES_DIR/$theme/wallpapers/" -type f -path "*/$wallpaper" 2>/dev/null | head -n1)"
    if [[ -n "$match" ]]; then
        echo "$match"
        return 0
    fi

    # 2. Base name match across common image extensions (.png, .jpg, .jpeg, .webp)
    local base="${wallpaper%.*}"
    for ext in png jpg jpeg webp PNG JPG JPEG WEBP; do
        match="$(find "$THEMES_DIR/$theme/wallpapers/" -type f -name "${base}.${ext}" 2>/dev/null | head -n1)"
        if [[ -n "$match" ]]; then
            echo "$match"
            return 0
        fi
    done

    return 1
}

find_blurred_wallpaper() {
    local wallpaper="$1"
    local theme="$2"

    # 1. Exact path match
    local match
    match="$(find "$BLUR_CACHE_DIR/$theme/" -type f -path "*/$wallpaper" 2>/dev/null | head -n1)"
    if [[ -n "$match" ]]; then
        echo "$match"
        return 0
    fi

    # 2. Base name match across common image extensions (.png, .jpg, .jpeg, .webp)
    local base="${wallpaper%.*}"
    for ext in png jpg jpeg webp PNG JPG JPEG WEBP; do
        match="$(find "$BLUR_CACHE_DIR/$theme/" -type f -name "${base}.${ext}" 2>/dev/null | head -n1)"
        if [[ -n "$match" ]]; then
            echo "$match"
            return 0
        fi
    done

    # 3. Preview gif fallback
    if [[ "$wallpaper" == *_preview* ]]; then
        local pbase="${wallpaper%%_preview*}"
        match="$(find "$BLUR_CACHE_DIR/$theme/" -type f -name "${pbase}*" 2>/dev/null | head -n1)"
        if [[ -n "$match" ]]; then
            echo "$match"
            return 0
        fi
    fi

    return 1
}

switch_wallpaper() {
    local wallpaper="$1"

    load_state
    local theme="$ACTIVE_THEME"

    local wallpaper_path
    wallpaper_path="$(find_wallpaper "$wallpaper" "$theme")"

    [[ -n "$wallpaper_path" ]] || die "Wallpaper not found: $wallpaper"

    local actual_filename
    actual_filename="$(basename "$wallpaper_path")"

    local blurred_wallpaper_path
    blurred_wallpaper_path="$(find_blurred_wallpaper "$actual_filename" "$theme")" || true

    if [[ -z "$blurred_wallpaper_path" ]]; then
        warn "Blurred wallpaper not found for '$actual_filename' in theme '$theme', using original wallpaper as fallback"
        blurred_wallpaper_path="$wallpaper_path"
    fi

    create_symlink \
        "$wallpaper_path" \
        "$CURRENT_WALLPAPER_LINK"
    create_symlink \
        "$blurred_wallpaper_path" \
        "$BLURRED_WALLPAPER_LINK"

    load_state
    ACTIVE_WALLPAPER="$actual_filename"
    save_state

    # Quickshell in-memory wallpaper update IPC
    qs -c ashell ipc call theme applyWallpaper "$actual_filename" >/dev/null 2>&1 || quickshell -c ashell ipc call theme applyWallpaper "$actual_filename" >/dev/null 2>&1 || true

    local msg="Wallpaper switched to '$actual_filename'"
    ok "$msg"
}

###############################################################################
# Main
###############################################################################

usage() {
    cat <<EOF
Usage:
  theme_switcher switch theme <theme>
  theme_switcher switch wallpaper <wallpaper>
  theme_switcher generate hyprlock
  theme_switcher generate all
EOF
}

main() {
    case "${1:-}" in
        switch)
            [[ $# -eq 3 ]] || die "Invalid switch arguments"

            case "$2" in
                theme)
                    switch_theme "$3"
                    "$SCRIPT_DIR"/reload all
                    ;;
                wallpaper)
                    switch_wallpaper "$3"
                    "$SCRIPT_DIR"/reload wallpaper
                    ;;
                *)
                    die "Unknown aspect: $2"
                    ;;
            esac
            ;;
        generate)
            case "${2:-}" in
                hyprlock)
                    generate_hyprlock_theme
                    ok "Hyprlock colors generated"
                    ;;
                cava)
                    generate_cava_theme
                    "$SCRIPT_DIR"/reload cava
                    ok "Cava theme generated"
                    ;;
                all)
                    generate_cava_theme
                    generate_hyprlock_theme
                    "$SCRIPT_DIR"/reload cava
                    ok "All generated themes updated"
                    ;;
                *)
                    die "Unknown generate target: ${2:-}"
                    ;;
            esac
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
