#!/usr/bin/env bash

# =========================================================
# Theme State Manager
# =========================================================
# Usage:
#
# Read values:
#   ./theme-state.sh get theme
#   ./theme-state.sh get wallpaper
#   ./theme-state.sh get waybar
#   ./theme-state.sh list
#
# Write values:
#   ./theme-state.sh set theme catppuccin
#   ./theme-state.sh set wallpaper forest.jpg
#   ./theme-state.sh set waybar compact
#
# =========================================================

set -euo pipefail

SCRIPT_DIR="$(dirname "${BASH_SOURCE[0]}")"
STATE_FILE="$SCRIPT_DIR/../state/active_theme.env"

# ---------------------------------------------------------
# Helpers
# ---------------------------------------------------------

ensure_file_exists() {
    if [[ ! -f "$STATE_FILE" ]]; then
        touch "$STATE_FILE"
    fi
}

load_state() {
    ensure_file_exists
    source "$STATE_FILE"
}

save_key() {
    local key="$1"
    local value="$2"

    ensure_file_exists

    if grep -q "^${key}=" "$STATE_FILE"; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$STATE_FILE"
    else
        echo "${key}=${value}" >> "$STATE_FILE"
    fi
}

print_usage() {
    cat <<EOF
Usage:

Read:
  $0 get theme
  $0 get wallpaper
  $0 get waybar
  $0 list

Write:
  $0 set theme <value>
  $0 set wallpaper <value>
  $0 set waybar <value>

Optional:
  STATE_FILE=/path/to/file.env $0 list
EOF
}

# ---------------------------------------------------------
# Commands
# ---------------------------------------------------------

cmd_get() {
    local field="$1"

    load_state

    case "$field" in
        theme)
            echo "${ACTIVE_THEME:-}"
            ;;
        wallpaper)
            echo "${ACTIVE_WALLPAPER:-}"
            ;;
        waybar)
            echo "${ACTIVE_WAYBAR_LAYOUT:-}"
            ;;
        *)
            echo "Invalid field: $field"
            exit 1
            ;;
    esac
}

cmd_set() {
    local field="$1"
    local value="$2"

    case "$field" in
        theme)
            save_key "ACTIVE_THEME" "$value"
            ;;
        wallpaper)
            save_key "ACTIVE_WALLPAPER" "$value"
            ;;
        waybar)
            save_key "ACTIVE_WAYBAR_LAYOUT" "$value"
            ;;
        *)
            echo "Invalid field: $field"
            exit 1
            ;;
    esac

    echo "Updated $field -> $value"
}

cmd_list() {
    load_state

    echo "ACTIVE_THEME=${ACTIVE_THEME:-}"
    echo "ACTIVE_WALLPAPER=${ACTIVE_WALLPAPER:-}"
    echo "ACTIVE_WAYBAR_LAYOUT=${ACTIVE_WAYBAR_LAYOUT:-}"
}

# ---------------------------------------------------------
# Main
# ---------------------------------------------------------

main() {
    local command="${1:-}"

    case "$command" in
        get)
            [[ $# -eq 2 ]] || { print_usage; exit 1; }
            cmd_get "$2"
            ;;
        set)
            [[ $# -eq 3 ]] || { print_usage; exit 1; }
            cmd_set "$2" "$3"
            ;;
        list)
            cmd_list
            ;;
        *)
            print_usage
            exit 1
            ;;
    esac
}

main "$@"